            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          }
        }
      },
      "DetalleBoleta": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "precio": {
            "type": "integer",
            "format": "int32",
            "description": "Precio unitario cobrado"
          },
          "cantidad": {
            "type": "integer",
            "format": "int32"
          },
          "subtotal": {
            "type": "integer",
            "format": "int32"
          }
