        ],
        "summary": "Detalle de una boleta",
        "description": "Administrador y Vendedor ven cualquiera; un cliente solo las suyas.",
        "operationId": "obtener_3",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "La boleta es de otra persona",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "404": {
            "description": "No existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Usuario de la sesión",
        "description": "Datos del dueño del token. Requiere estar autenticado.",
        "operationId": "yo",
        "responses": {
          "401": {
            "description": "Sin token o token vencido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UsuarioRequest": {
        "type": "object",
        "description": "Datos de usuario para el panel de administración",
        "properties": {
          "run": {
            "type": "string",
            "example": "12345678-5",
            "minLength": 1,
            "pattern": "^[0-9]{6,8}-[0-9kK]$"
          },
          "nombre": {
            "type": "string",
            "example": "Pedro",
            "maxLength": 50,
            "minLength": 0
          },
          "apellidos": {
            "type": "string",
            "example": "Díaz",
            "maxLength": 100,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "example": "pedro.diaz@duoc.cl",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "(?i)^[^\\s@]+@(duoc\\.cl|profesor\\.duoc\\.cl|gmail\\.com)$"
          },
          "password": {
            "type": "string",
            "description": "Obligatoria al crear; opcional al editar",
            "example": "vend123",
            "maxLength": 10,
            "minLength": 0
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "tipoUsuario": {
            "type": "string",
            "enum": [
              "Administrador",
              "Vendedor",
              "Cliente"
            ],
            "example": "Vendedor"
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "comuna": {
            "type": "string",
            "minLength": 1
          },
          "direccion": {
            "type": "string",
            "maxLength": 300,
            "minLength": 0
          }
        },
        "required": [
          "apellidos",
          "comuna",
          "correo",
          "direccion",
          "nombre",
          "region",
          "run",
          "tipoUsuario"
        ]
      },
      "ErrorRespuesta": {
        "type": "object",
        "description": "Respuesta de error",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-06T15:00:00Z"
          },
          "estado": {
            "type": "integer",
            "format": "int32",
            "example": 409
          },
          "error": {
            "type": "string",
            "example": "Conflict"
          },
          "mensaje": {
            "type": "string",
            "example": "Ya existe un producto con ese código."
          },
          "ruta": {
            "type": "string",
            "example": "/api/v1/productos"
          },
          "errores": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Errores por campo (solo en validaciones)"
          }
        }
      },
      "PerfilRequest": {
        "type": "object",
        "description": "Datos editables del propio perfil",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "apellidos": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "description": "Opcional: si viene vacía se conserva la actual",
            "maxLength": 10,
            "minLength": 0
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "comuna": {
            "type": "string",
            "minLength": 1
          },
          "direccion": {
            "type": "string",
            "maxLength": 300,
            "minLength": 0
          }
        },
        "required": [
          "apellidos",
          "comuna",
          "direccion",
          "nombre",
          "region"
        ]
      },
      "UsuarioDTO": {
        "type": "object",
        "description": "Usuario (sin contraseña)",
        "properties": {
          "run": {
            "type": "string",
            "example": "11111111-1"
          },
          "nombre": {
            "type": "string",
            "example": "María"
          },
          "apellidos": {
            "type": "string",
            "example": "Pérez Soto"
          },
          "correo": {
            "type": "string",
            "example": "maria.perez@gmail.com"
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "tipoUsuario": {
            "type": "string",
            "enum": [
              "Administrador",
              "Vendedor",
              "Cliente"
            ],
            "example": "Administrador"
          },
          "region": {
            "type": "string"
          },
          "comuna": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          }
        }
      },
      "ProductoRequest": {
        "type": "object",
        "description": "Datos de un producto",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "AC010",
            "maxLength": 20,
            "minLength": 3
          },
          "nombre": {
            "type": "string",
            "example": "Cable de instrumento 3 m",
            "maxLength": 100,
            "minLength": 0
          },
          "categoriaId": {
            "type": "string",
            "example": "accesorios",
            "minLength": 1
          },
          "marca": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "modelo": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "descripcion": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "imagen": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "precio": {
            "type": "integer",
            "format": "int32",
            "example": 9990,
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "example": 10,
            "minimum": 0
          },
          "stockCritico": {
            "type": "integer",
            "format": "int32",
            "description": "Si no se envía se usa 3",
            "example": 3,
            "minimum": 0
          },
          "oferta": {
            "type": "boolean"
          },
          "precioOferta": {
            "type": "integer",
            "format": "int32",
            "description": "Obligatorio si oferta = true; no puede superar el precio",
            "minimum": 0
          }
        },
        "required": [
          "categoriaId",
          "codigo",
          "nombre",
          "precio",
          "stock"
        ]
      },
      "ProductoDTO": {
        "type": "object",
        "description": "Producto del catálogo",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "GA001"
          },
          "nombre": {
            "type": "string",
            "example": "Guitarra Acústica Folk"
          },
          "categoriaId": {
            "type": "string",
            "example": "guitarras-acusticas"
          },
          "categoria": {
            "type": "string",
            "example": "Guitarras Acústicas"
          },
          "marca": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "imagen": {
            "type": "string"
          },
          "precio": {
            "type": "integer",
            "format": "int32",
            "example": 129990
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "example": 8
          },
          "stockCritico": {
            "type": "integer",
            "format": "int32",
            "example": 3
          },
          "oferta": {
            "type": "boolean"
          },
          "precioOferta": {
            "type": "integer",
            "format": "int32",
            "example": 110490
          },
          "precioVigente": {
            "type": "integer",
            "format": "int32",
            "description": "Precio que se cobra (de oferta si corresponde)",
            "example": 110490
          },
          "critico": {
            "type": "boolean",
            "description": "true si stock <= stockCritico"
          }
        }
      },
      "CategoriaRequest": {
        "type": "object",
        "description": "Datos de una categoría",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Vientos y Metales",
            "maxLength": 50,
            "minLength": 0
          },
          "descripcion": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "color": {
            "type": "string",
            "example": "#2A241C",
            "pattern": "^$|^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "CategoriaDTO": {
        "type": "object",
        "description": "Categoría con la cantidad de productos que tiene",
        "properties": {
          "id": {
            "type": "string",
            "example": "baterias"
          },
          "nombre": {
            "type": "string",
            "example": "Baterías"
          },
          "descripcion": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "example": "#4A3B5C"
          },
          "cantidadProductos": {
            "type": "integer",
            "format": "int64",
            "example": 5
          }
        }
      },
      "BoletaRequest": {
        "type": "object",
