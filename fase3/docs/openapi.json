      },
      "AuthRespuesta": {
        "type": "object",
        "description": "Token JWT y datos del usuario autenticado",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT a enviar en el encabezado Authorization: Bearer <token>"
          },
          "tipo": {
            "type": "string",
            "example": "Bearer"
          },
          "expiraEn": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora en que el token deja de ser válido"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioDTO"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Credenciales para iniciar sesión",
        "properties": {
          "correo": {
            "type": "string",
            "example": "maria.perez@gmail.com",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "example": "admin123",
            "minLength": 1
          }
        },
        "required": [
          "correo",
          "password"
        ]
      },
      "ProductoVendido": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "unidades": {
            "type": "integer",
            "format": "int64"
          },
          "monto": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ReporteVentasDTO": {
        "type": "object",
        "description": "Resumen de ventas para el panel de reportes",
        "properties": {
          "cantidadOrdenes": {
            "type": "integer",
            "format": "int32",
            "example": 12
          },
          "totalVendido": {
            "type": "integer",
            "format": "int64",
            "example": 1850000
          },
          "ticketPromedio": {
            "type": "integer",
            "format": "int64",
            "example": 154167
          },
          "unidadesEnStock": {
            "type": "integer",
            "format": "int64",
            "example": 230
          },
          "topProductos": {
            "type": "array",
            "description": "Top 5 por unidades vendidas",
            "items": {
              "$ref": "#/components/schemas/ProductoVendido"
            }
          },
          "porCategoria": {
            "type": "array",
            "description": "Monto vendido por categoría, de mayor a menor",
