          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemCompra"
            },
            "minItems": 1
          },
          "cupon": {
            "type": "string",
            "description": "Opcional",
            "example": "SONIDOVIVO10"
          }
        },
        "required": [
          "cliente",
          "direccion",
          "items"
        ]
      },
      "ClienteCompra": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Camila",
            "maxLength": 50,
            "minLength": 0
          },
          "apellidos": {
            "type": "string",
            "example": "Rojas Vera",
            "maxLength": 100,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "example": "camila.rojas@gmail.com",
            "minLength": 1,
            "pattern": "(?i)^[^\\s@]+@(duoc\\.cl|profesor\\.duoc\\.cl|gmail\\.com)$"
          }
        },
        "required": [
          "apellidos",
          "correo",
          "nombre"
        ]
      },
      "DireccionEntrega": {
        "type": "object",
