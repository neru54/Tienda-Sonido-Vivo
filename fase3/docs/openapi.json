          },
          "comuna": {
            "type": "string",
            "example": "Quilpué",
            "minLength": 1
          },
          "direccion": {
            "type": "string",
            "example": "Los Carrera 123",
            "maxLength": 300,
            "minLength": 0
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date",
            "example": "2000-01-31"
          }
        },
        "required": [
          "apellidos",
