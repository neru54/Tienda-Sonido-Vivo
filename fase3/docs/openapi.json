{
  "openapi": "3.1.0",
  "info": {
    "title": "Sonido Vivo API",
    "description": "API REST de la tienda de instrumentos Sonido Vivo: catálogo, categorías, usuarios, boletas (checkout) y reportes. Autenticación con JWT: obtén el token en POST /api/v1/auth/login y úsalo con el botón Authorize.",
    "contact": {
      "name": "Equipo Sonido Vivo - DSY1104"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Desarrollo local"
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Login, registro de clientes y datos de la sesión"
    },
    {
      "name": "Usuarios",
      "description": "CRUD solo Administrador; /me para la propia cuenta"
    },
    {
      "name": "Reportes",
      "description": "Métricas de ventas. Solo Administrador"
    },
    {
      "name": "Productos",
      "description": "Catálogo. Lectura pública; escritura solo Administrador"
    },
    {
      "name": "Categorías",
      "description": "Lectura pública; escritura solo Administrador"
    },
    {
      "name": "Boletas",
      "description": "Checkout (público) y consulta de órdenes"
    }
  ],
  "paths": {
    "/api/v1/usuarios/{run}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Detalle de un usuario",
        "description": "Solo Administrador.",
        "operationId": "obtener",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "No existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Actualizar usuario",
        "description": "Contraseña vacía = se conserva. Solo Administrador.",
        "operationId": "actualizar",
