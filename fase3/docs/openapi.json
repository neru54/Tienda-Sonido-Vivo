            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "region": {
            "type": "string",
            "example": "Región Metropolitana de Santiago",
            "minLength": 1
          },
          "comuna": {
            "type": "string",
            "example": "Providencia",
            "minLength": 1
          },
          "indicaciones": {
            "type": "string",
            "maxLength": 300,
            "minLength": 0
          }
        },
        "required": [
          "calle",
          "comuna",
          "region"
        ]
      },
      "ItemCompra": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "GA001",
            "minLength": 1
          },
          "cantidad": {
            "type": "integer",
            "format": "int32",
            "example": 2,
            "minimum": 1
          }
        },
        "required": [
          "cantidad",
          "codigo"
        ]
      },
      "BoletaDTO": {
        "type": "object",
        "description": "Boleta (cabecera + detalle)",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "string",
            "example": "Pagada"
          },
          "cliente": {
            "$ref": "#/components/schemas/ClienteBoleta"
          },
          "direccion": {
            "$ref": "#/components/schemas/DireccionBoleta"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleBoleta"
            }
          },
          "cupon": {
            "type": "string",
            "example": "SONIDOVIVO10"
          },
          "subtotal": {
            "type": "integer",
            "format": "int32",
            "example": 259980
          },
          "descuento": {
            "type": "integer",
            "format": "int32",
            "example": 25998
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "example": 233982
          }
        }
      },
      "ClienteBoleta": {
        "type": "object",
        "properties": {
          "run": {
            "type": "string",
            "description": "null si se compró sin cuenta"
          },
