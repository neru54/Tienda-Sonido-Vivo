            "type": "string"
          },
          "indicaciones": {
            "type": "string"
          }
        }
      },
      "RegistroRequest": {
        "type": "object",
        "description": "Datos para crear una cuenta de cliente desde la tienda",
        "properties": {
          "run": {
            "type": "string",
            "example": "12345678-5",
            "minLength": 1,
            "pattern": "^[0-9]{6,8}-[0-9kK]$"
          },
          "nombre": {
            "type": "string",
            "example": "Ana",
            "maxLength": 50,
            "minLength": 0
          },
          "apellidos": {
            "type": "string",
            "example": "Soto Díaz",
            "maxLength": 100,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "example": "ana.soto@gmail.com",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "(?i)^[^\\s@]+@(duoc\\.cl|profesor\\.duoc\\.cl|gmail\\.com)$"
          },
          "password": {
