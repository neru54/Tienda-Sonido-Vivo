# Copia este archivo como .env (o .env.production) y ajusta la URL de la API.
# La URL es la del API GATEWAY (puerto 8080), único punto de entrada a los microservicios.
# Si no se define, el frontend usa http://localhost:8080/api/v1
#   Local o Docker:  http://localhost:8080/api/v1
#   AWS (EC2):       http://<ip-o-dns-publico-de-la-ec2>:8080/api/v1  (deploy-s3.ps1 -ApiUrl la define)
VITE_API_URL=http://localhost:8080/api/v1
